# Beispiel fuer .env. Diese Datei gehoert ins Git, die echte .env nicht.
#
# Zugang zum Hermes-Server. Beides bleibt auf dem Server dieser App,
# nichts davon wird an den Browser ausgeliefert.
HERMES_BASIS=http://127.0.0.1:8642
HERMES_KEY=

# Pfad zum Kommandozeilenwerkzeug des Harness. Leer lassen heisst:
# die App sucht `hermes` im PATH.
HERMES_BIN=

# Public address of this app, exactly as you open it in the browser. Without
# it the server assumes https and the login form is rejected as cross-site
# (HTTP 403). Change it when you use another port or a reverse proxy:
#   local            -> http://127.0.0.1:3000
#   behind a proxy   -> https://app.example.com
#   in the tailnet   -> https://your-machine.your-tailnet.ts.net
ORIGIN=http://127.0.0.1:3000

# Access door, three clearly separated cases:
#   1. APP_TOKEN set: every server route under /api/ (except /api/status)
#      needs a signed cookie.
#   2. APP_TOKEN empty but HERMES_KEY set: at startup the app generates a
#      random token, writes it here and shows it once on the startup output.
#      The door is active afterwards; log in at /anmelden.
#   3. Both empty: the door stays off and the app runs on sample data.
#      /api/board and /api/experten then answer built-in examples instead of
#      401, so a first visit is not stuck behind a login that cannot exist.
APP_TOKEN=

# Schluessel zum Signieren des Cookies. Fehlt er, erzeugt die App beim Start
# einen zufaelligen Wert und schreibt ihn in die .env; die alte Datei wird
# vorher als .env.bak gesichert. Diesen Wert nicht weitergeben.
APP_SECRET=

# Sichtbarer Name der App in Titel, Sitzung und Platzhaltern. Vorgabe: OpenManatee.
PUBLIC_APP_NAME=OpenManatee
